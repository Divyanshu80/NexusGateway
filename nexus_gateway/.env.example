# NexusGateway Configuration
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Distributed Rate Limiting & Storage (Optional, defaults to local in-memory)
REDIS_URL=redis://localhost:6379/0

# Live LLM Provider API Keys (Optional - mock providers work without keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama Provider URL (Optional)
OLLAMA_BASE_URL=http://localhost:11434
